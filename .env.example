DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/Disruptors
AIVEN_DATABASE_URL=

# Aiven Kafka. Leave blank locally; the transactional outbox still records events.
AIVEN_KAFKA_BROKERS=
AIVEN_KAFKA_CLIENT_ID=disruptors-dependency
AIVEN_KAFKA_SECURITY_PROTOCOL=SSL
AIVEN_KAFKA_CA_FILE=
AIVEN_KAFKA_CERT_FILE=
AIVEN_KAFKA_KEY_FILE=
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=
AIVEN_KAFKA_SASL_MECHANISM=PLAIN
AIVEN_KAFKA_CONSUMER_GROUP=dependency-incident-orchestrator
AIVEN_KAFKA_AUTO_OFFSET_RESET=earliest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_PLANNER_CHANNEL=
SLACK_WEBHOOK_URL=
DEPENDENCY_ALLOW_EXTERNAL_MESSAGES=false

# Never commit real secrets.

# Set a strong random token before exposing the API to remote writers.
# Loopback demo writes work without this token; remote writes fail closed.
DEPENDENCY_WRITE_TOKEN=

# Explicitly choose operational DB when DATABASE_URL and AIVEN_DATABASE_URL both exist.
# Leave blank with just DATABASE_URL for the current local demo.
DEPENDENCY_DATABASE_TARGET=

# Free Kafka uses one physical topic for all event-envelope types.
AIVEN_KAFKA_ROUTING_MODE=single
AIVEN_KAFKA_PHYSICAL_TOPIC=dependency.events
